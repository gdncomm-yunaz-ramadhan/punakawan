uct { ID string; NextAction string }\ntype DossierRef struct { ID string; Status string }\ntype ImpactSummary struct { RequiredRepositories []string; ExcludedRepositories []string }\n\n// Per-role contributions\ntype SemarContribution struct {\n    Objective          Objective\n    CurrentPhase       string\n    AcceptedPlan       *PlanRef\n    RoleConfigRevision int\n}\ntype GarengContribution struct {\n    OpenContradictions []string\n    UnresolvedRisks    []string\n    ImpactSummary      *ImpactSummary\n}\ntype PetrukContribution struct {\n    ChangedRepositories []string\n    CompletedTasks      []string\n    CurrentTask         *TaskRef\n}\ntype BagongContribution struct {\n    Evidence []string\n    Dossier  *DossierRef\n}\n\n// One-shot form (Semar required; other three nil-skippable) — recommended for the MCP tool\nfunc Assemble(projectID, runID string, semar SemarContribution,\n    gareng *GarengContribution, petruk *PetrukContribution, bagong *BagongContribution) protocol.HandoffCapsule\n\n// Fluent form\nfunc NewCapsule(projectID, runID string, semar SemarContribution) *CapsuleBuilder\nfunc (b *CapsuleBuilder) WithID(id string) *CapsuleBuilder      // override derived \"handoff-&lt;runID&gt;\"\nfunc (b *CapsuleBuilder) WithGareng(g GarengContribution) *CapsuleBuilder\nfunc (b *CapsuleBuilder) WithPetruk(p PetrukContribution) *CapsuleBuilder\nfunc (b *CapsuleBuilder) WithBagong(bg BagongContribution) *CapsuleBuilder\nfunc (b *CapsuleBuilder) Build() protocol.HandoffCapsule\n```\n\nNote: `Id` defaults to `\"handoff-&lt;runID&gt;\"`; use `WithID` (or set `.Id` on the returned capsule) when a run needs multiple capsules (the §41 example `handoff-run-1842-03`).\n\n## Tests added (`builder_test.go`)\n\n- Assemble from all four contributions -&gt; Create -&gt; Get -&gt; asserts each role's section round-trips.\n- Fluent vs one-shot equivalence; Semar-only capsule is valid.\n- Assemble + `Validate` with nil deps -&gt; resumable (proves the shape is well-formed).